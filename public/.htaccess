# Lives in public/ so every build carries it into dist/: it used to exist only
# on the server, and a deploy with --delete wiped it, turning every deep link
# into a 404.

# SPA routing: anything that is not a real file or directory is answered by
# index.html, so /player/573964 survives a reload or a shared link. Real
# subdirectories (smurfs/) still win, because of the !-d condition.
Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

<IfModule mod_headers.c>
  # index.html names the hashed assets, so caching it serves the previous
  # build's file names after a deploy.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Those hashed names change on every build, so they can be kept forever.
  <FilesMatch "\.(js|css|woff2?|png|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
